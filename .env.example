# Local development: enable the dev-login bypass so you don't need a Firebase
# project. Set to false to authenticate against real Firebase.
AUTH_DEV_MODE=true

# Address the server listens on (optional, defaults to 127.0.0.1:3000).
# LISTEN_ADDR=127.0.0.1:3000

# Dev mode lets anyone log in as any email, so it refuses to run on a non loopback address.
# ALLOW_DEV_MODE=true overrides that check, for example on a trusted LAN. Never set it in production.

# Firebase web app settings (required when AUTH_DEV_MODE=false), from the Firebase console.
# They are public identifiers, not secrets. The auth domain is a host name, without https://.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Login, session and logout requests allowed per client IP per window (defaults to 30 per 1m).
# An unset or invalid value keeps the strict default. Tests raise the limit instead of removing it.
# AUTH_RATE_LIMIT=30
# AUTH_RATE_WINDOW=1m

# Behind a reverse proxy, set the header that carries the client IP and the proxies allowed to set it.
# PROXY_HEADER without TRUSTED_PROXIES is refused at startup.
# PROXY_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=127.0.0.1

# Logs are structured. LOG_FORMAT is json (default, one JSON object per line) or text (key=value, easier to read
# locally), and LOG_LEVEL is debug, info (default), warn or error. Debug also logs every query and static file.
# LOG_FORMAT=json
# LOG_LEVEL=info

# SQLite database file, also used for sessions (optional, defaults to ./data/logbog.db).
# The directory is created on startup.
# DB=./data/logbog.db
